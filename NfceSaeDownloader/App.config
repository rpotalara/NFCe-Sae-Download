<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <appSettings>
    <add key="SaeVersaoLayout" value="1.00" />
    <add key="SoapTimeoutMs" value="120000" />
    <add key="DelayEntreChamadasMs" value="600" />
    <add key="DiretorioSaidaPadrao" value="C:\NFCE\SAE\XML" />
    <add key="StoreLocation" value="CurrentUser" />
    <add key="StoreName" value="My" />
    <add key="ListagemNamespace" value="http://www.portalfiscal.inf.br/nfce/sae/listagem" />
    <add key="DownloadNamespace" value="http://www.portalfiscal.inf.br/nfce/sae/download" />
    <add key="ListagemSoapAction" value="http://www.portalfiscal.inf.br/nfce/sae/listagem/NFCeListagemChaves" />
    <add key="DownloadSoapAction" value="http://www.portalfiscal.inf.br/nfce/sae/download/NFCeDownloadXML" />
  </appSettings>
</configuration>
